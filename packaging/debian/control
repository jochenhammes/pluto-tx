Package: pluto-tx
Architecture: amd64 arm64
Depends: ${shlibs:Depends}, ${misc:Depends}, ${python3:Depends}, ${gnuradio:Depends},
 python3 (>= 3.11), python3-pyqt5, python3-pyqtgraph, python3-numpy,
 python3-libiio, libiio-utils, avahi-daemon,
 soapysdr-module-hackrf, soapysdr-module-rtlsdr, python3-soapysdr, hackrf, rtl-sdr,
 python3-pil, fonts-dejavu-mono, python3-serial, python3-cryptography, python3-meshtastic,
 python3-fastapi, python3-uvicorn, python3-websockets, python3-pydantic, openssl
Recommends: wsjtx
Suggests: js8call
Description: SDR transceiver apps for PlutoSDR, HackRF and RTL-SDR (GNU Radio)
 pluto-tx (transmitter), pluto-advanced-rx (receiver with waterfall),
 pluto-cli (headless) and Web-TRX (browser interface) for amateur radio
 on the ADALM-Pluto, HackRF One and RTL-SDR.
 .
 Modes: FM, SSB, FreeDV/RADE, M17, FT8, JS8, PSK31, RTTY, POCSAG,
 LoRa (Meshtastic, MeshCore), Digitext and file broadcast.
 .
 This package includes prebuilt copies of gr-m17, gr-lora_sdr, rade_c,
 ft8_lib and JS8Call's decoder (js8ref), kept private in /usr/lib/pluto-tx.

# Konfiguration der Merge-Skripte. Kopieren nach ~/merge-web-trx/merge.env
# (AUSSERHALB der Repos) und bei Bedarf anpassen; ohne Datei gelten genau
# diese Standardwerte. Anderer Ort: MERGE_ENV=/pfad/merge.env vor dem Skript.

# Produktiv-Checkouts auf dem Radio-Server
PLUTO_TX_DIR="$HOME/Dokumente/plutosdr"
WEB_TRX_OLD_DIR="$HOME/Dokumente/Web-TRX"

# Arbeitsbereich: Scratch-Klone, Backups, Logs, Testergebnisse (nie in einem Repo)
MERGE_HOME="$HOME/merge-web-trx"
WORK_DIR="$MERGE_HOME/work"
BACKUP_DIR="$MERGE_HOME/backup"
LOG_DIR="$MERGE_HOME/logs"
RESULTS_DIR="$MERGE_HOME/results"

# Erwartete GitHub-Remotes (Teilstring von 'git remote get-url origin')
PLUTO_TX_REMOTE_MATCH="jochenhammes/pluto-tx"
WEB_TRX_REMOTE_MATCH="jochenhammes/Web-TRX"

# Welcher Web-TRX-Commit importiert wird (leer = HEAD von WEB_TRX_OLD_DIR)
WEB_TRX_SHA=""

MERGE_BRANCH="merge-web-trx"
SMOKE_PORT=8322     # sim-Server des Smoke-Tests (40_verify.sh), nur 127.0.0.1
PROD_PORT=8321      # Port des Produktiv-Servers
